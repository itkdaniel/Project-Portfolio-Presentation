DATABASE_URL=postgresql://nexusauth:nexusauth@localhost:5432/nexusauth
REDIS_URL=redis://localhost:6379/0

# REQUIRED: Strong secret for HMAC-SHA256 signing (min 32 chars)
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-32-chars

# Token TTLs (seconds)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

PORT=3001
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: HaveIBeenPwned API key for password breach checks
# HIBP_API_KEY=

LOG_LEVEL=info
